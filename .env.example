# Copy to .env and fill in. All are optional — the app falls back gracefully
# without them (weather/traffic use sample values; live buses need OTD_API_KEY).

# https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# https://developer.tomtom.com
TOMTOM_API_KEY=your_key_here

# https://otd.delhi.gov.in — real-time bus positions (GTFS-Realtime)
OTD_API_KEY=your_key_here
