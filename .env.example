# Copy to .env and fill in. The API keys are optional — the app falls back
# gracefully without them (weather/traffic use sample values; live buses need
# OTD_API_KEY).

# ── Django ───────────────────────────────────────────────────────────────────
# Leave DJANGO_DEBUG=True for local development.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=
# Comma-separated hostnames, required in production (dev defaults to *).
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# Origin allowed to call the API cross-origin (dev defaults to *).
# CORS_ALLOW_ORIGIN=https://your-frontend.example.com
# Needed if you serve over HTTPS behind a proxy:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ── Third-party APIs ─────────────────────────────────────────────────────────

# https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# https://developer.tomtom.com
TOMTOM_API_KEY=your_key_here

# https://otd.delhi.gov.in — real-time bus positions (GTFS-Realtime)
OTD_API_KEY=your_key_here
